<%- include("partials/header", { title: "Reset your password" }) %>
<h1 style="margin:0 0 16px; font-size:20px; color:#111827;">Reset your password</h1>
<p style="margin:0 0 8px; font-size:14px; line-height:22px; color:#374151;">Hi <%= name %>,</p>
<p style="margin:0 0 24px; font-size:14px; line-height:22px; color:#374151;">
	We received a request to reset the password for your Content Automation account. Use the code below to continue.
</p>
<%- include("partials/otp-box", { otp, expiresInMinutes }) %>
<p style="margin:0 0 24px; font-size:14px; line-height:22px; color:#374151;">
	If you didn't request a password reset, please ignore this email — your password will remain unchanged.
</p>
<%- include("partials/footer") %>
