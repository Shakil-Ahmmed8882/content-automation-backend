<%- include("partials/header", { title: "Your content was published" }) %>
<h1 style="margin:0 0 16px; font-size:20px; color:#111827;">Publishing finished</h1>
<p style="margin:0 0 8px; font-size:14px; line-height:22px; color:#374151;">Hi <%= name %>,</p>
<p style="margin:0 0 20px; font-size:14px; line-height:22px; color:#374151;">
	Your post <strong><%= postTitle %></strong> finished publishing. Here is the per-platform result:
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
	<% results.forEach(function (r) { %>
	<tr>
		<td style="padding:12px 16px; border-bottom:1px solid #f3f4f6; font-size:14px; color:#374151;">
			<strong><%= r.platformName %></strong>
			<% if (r.accountName) { %><span style="color:#9ca3af;"> · <%= r.accountName %></span><% } %>
		</td>
		<td align="right" style="padding:12px 16px; border-bottom:1px solid #f3f4f6; font-size:14px;">
			<% if (r.status === "SUCCESS") { %>
				<span style="color:#047857; font-weight:600;">&#10003; Published</span>
				<% if (r.url) { %><br /><a href="<%= r.url %>" style="font-size:12px; color:#4f46e5;">View post</a><% } %>
			<% } else { %>
				<span style="color:#b91c1c; font-weight:600;">&#10007; Failed</span>
			<% } %>
		</td>
	</tr>
	<% }); %>
</table>
<p style="margin:0 0 24px; font-size:13px; line-height:20px; color:#6b7280;">
	Overall status: <strong><%= overallStatus %></strong>. You can retry any failed platform from your Executions page.
</p>
<%- include("partials/footer") %>
