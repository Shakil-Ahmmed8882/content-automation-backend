{
	"name": "content-automation-platform-backend",
	"version": "1.0.0",
	"description": "Write once, publish to multiple platforms. Backend for the Content Automation Platform.",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/src/server.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"devdb:start": "\"C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe\" -D .devdb/data -l .devdb/logfile.txt -o \"-p 5433\" start",
		"devdb:stop": "\"C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe\" -D .devdb/data stop",
		"devredis:start": "\"./.devdb/redis-portable/redis-server.exe\" ./.devdb/redis-portable/redis.windows.conf --port 6379",
		"devredis:stop": "\"./.devdb/redis-portable/redis-cli.exe\" -p 6379 shutdown nosave",
		"test": "vitest run",
		"test:watch": "vitest",
		"format:check": "biome format .",
		"format:fix": "biome format --write .",
		"lint:check": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:fix:unsafe": "biome check --write --unsafe .",
		"ci": "biome ci ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.34.0",
		"cloudinary": "^2.10.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"ejs": "^6.0.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.0.1",
		"google-auth-library": "^11.0.0",
		"helmet": "^8.1.0",
		"http-status": "^2.1.0",
		"ioredis": "^5.4.2",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.0.5",
		"pg": "^8.22.0",
		"redis": "^6.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.1.2",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^7.2.1",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
