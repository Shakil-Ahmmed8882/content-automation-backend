NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────────────────────
# Prisma does NOT auto-load this file; prisma.config.ts imports "dotenv/config".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/content_automation?schema=public"

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Absolute base URLs.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# ── Google OAuth (login) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ── Seed users (server refuses to boot if missing) ───────────────────────────
SUPER_ADMIN_NAME=Seed Super Admin
SUPER_ADMIN_EMAIL=superadmin@contentautomation.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!

ADMIN_NAME=Seed Admin
ADMIN_EMAIL=admin@contentautomation.com
ADMIN_PASSWORD=Admin123!

# ── Redis (OTP flows, bKash token cache, BullMQ backing store) ───────────────
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# ── SMTP (verify-email / forgot-password / password-changed) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_SENDER=your-email@gmail.com

# ── Cloudinary (post image storage) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── LinkedIn OAuth + publishing ──────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/connections/linkedin/callback

# ── Facebook Page OAuth + publishing ─────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/v1/connections/facebook/callback
FACEBOOK_API_VERSION=v21.0

# ── bKash payment (Premium upgrade) ──────────────────────────────────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback

# ── Premium pricing ──────────────────────────────────────────────────────────
PREMIUM_PRICE=500
PREMIUM_CURRENCY=BDT
